# ============================================
# 환경변수 템플릿 — 이 파일을 복사해 .env 로 만들고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore/.dockerignore 로 제외되어 VCS/이미지에 포함되지 않는다.
# ⚠️ 실제 시크릿을 이 .env.example 에 채우지 말 것 (이 파일은 커밋 대상).
# ============================================

# 이 서비스는 순수 클라이언트 사이드 도구 모음이다.
#  - 서버 API 없음 / 데이터베이스 없음 / 외부 API 키 없음
#  - 서버는 SPA 정적 서빙 + 헬스체크(/healthz)만 담당
# 따라서 로컬 개발에 필요한 환경변수는 없다. 아래는 운영 배포 시에만 쓰인다.

# ============================================
# 운영 환경(Railway) — 보통 Railway 대시보드의 "서비스 Variables"에 등록한다.
# ============================================

# 공개 base URL (운영) — 절대 URL 조립 기준. 미설정/localhost 면 prod 기동 실패(fail-fast).
# 도메인을 구매하기 전에는 Railway 가 발급한 기본 도메인을 넣으면 된다.
# APP_PUBLIC_BASE_URL=https://your-app.up.railway.app

# 포트는 Railway 가 자동 주입한다(PORT). 직접 설정할 필요 없음.
